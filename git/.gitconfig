[user]
	name = JM Faircloth
	email = fairclothjm@gmail.com
	signingkey = /Users/jmf/.ssh/id_ed25519.pub

[includeIf "gitdir:~/"]
    path = ~/code/dotfiles/work/.gitconfig

[core]
	excludesfile = ~/.gitignore_global
	editor = vim
[push]
	default = simple
[alias]
	co = checkout
	st = status
	d = diff
	br = branch
[maintenance]
	repo = /Users/jmf/hc/vault
	repo = /Users/jmf/hc/vault-enterprise
	repo = /Users/jmf/hc/terraform-provider-vault
	repo = /Users/jmf/hc/web-unified-docs

[url "ssh://git@github.com/"]
    insteadOf = https://github.com/
[init]
	defaultBranch = main
[pull]
	ff = only
[gpg]
	format = ssh
[commit]
	gpgsign = true
